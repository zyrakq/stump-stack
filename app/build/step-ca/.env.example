# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=stump

# Docker image
IMAGE=aaronleopold/stump:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

PUID=1000
PGID=1000

STUMP_ENABLE_UPLOAD=true
UPLOAD_FILE=true
DOWNLOAD_FILE=true
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=10801
VIRTUAL_HOST=stump.local

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=stump.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com

STUMP_TRUST_PROXY_HEADERS=true